// The demo app's Worker config, rendered to wrangler.jsonc (git-ignored) by
// tooling/wire. __ENV__ is the environment it is rendered for. The demo needs
// no bindings beyond its static assets.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reacher-x-demo-__ENV__",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
}
